#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/hust-network-login
CONF=/etc/hust-network-login.conf

start_service() {
    if [ ! -x "$PROG" ]; then
        echo "missing executable: $PROG" >&2
        return 1
    fi
    if [ ! -r "$CONF" ]; then
        echo "missing configuration: $CONF" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" "$CONF"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
